{
  "说明": "六爻预测基础知识：六亲、六神、世应规则、用神分类",
  "六亲": {
    "说明": "六亲是六爻预测的核心分类体系，每爻都有一个六亲属性",
    "分类": {
      "父母": {
        "含义": "生我者为父母，代表长辈、文书、证件、房屋、衣物、保护",
        "取用": "占考试、文书、房屋、长辈健康等取父母为用神"
      },
      "兄弟": {
        "含义": "同我者为兄弟，代表竞争、阻碍、破财、朋友、同事",
        "取用": "占合作、竞争、朋友关系等取兄弟为用神"
      },
      "子孙": {
        "含义": "我生者为子孙，代表福德、医药、快乐、下属、解忧",
        "取用": "占子女、医药、快乐、解忧等取子孙为用神"
      },
      "妻财": {
        "含义": "我克者为妻财，代表妻子、钱财、财产、食物、收获",
        "取用": "占财运、婚姻（男占）、求财等取妻财为用神"
      },
      "官鬼": {
        "含义": "克我者为官鬼，代表官职、丈夫、疾病、忧愁、压力、领导",
        "取用": "占事业、功名、婚姻（女占）、疾病等取官鬼为用神"
      }
    },
    "装六亲规则": {
      "说明": "以每宫首卦的五行为'我'，各爻地支五行与'我'论生克定六亲",
      "规则": [
        "生我者为父母",
        "同我者为兄弟",
        "我生者为子孙",
        "我克者为妻财",
        "克我者为官鬼"
      ],
      "示例": "如乾宫属金，则地支属金之爻为兄弟，属水之爻为子孙，属木之爻为妻财，属火之爻为官鬼，属土之爻为父母"
    }
  },
