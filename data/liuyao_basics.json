      "出行": "世爻为用神，应爻为目的地",
      "失物": "妻财为用神",
      "诉讼": "以世爻为我方，应爻为对方",
      "天气": "父母主雨，子孙主晴",
      "行人": "以用神所在爻的动静来判断"
    }
