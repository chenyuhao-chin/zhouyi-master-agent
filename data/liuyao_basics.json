        "五世卦": {"世爻": "五爻", "应爻": "二爻"},
        "游魂卦": {"世爻": "四爻", "应爻": "初爻"},
        "归魂卦": {"世爻": "三爻", "应爻": "六爻"},
        "本宫卦": {"世爻": "六爻", "应爻": "三爻"}
