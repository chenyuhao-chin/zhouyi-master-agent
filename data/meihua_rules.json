{
  "梅花易数规则": {
    "说明": "梅花易数由北宋邵雍（邵康节）所创，核心理念为'心易'",
    "来源": "《梅花易数》（邵雍著）"
  },
  "起卦方法": {
    "数字起卦": {
      "描述": "心中默想两个数字起卦",
      "规则": {
        "上卦": "第一个数 ÷ 8 取余数，对应先天八卦数（无余数则取8=坤）",
        "下卦": "第二个数 ÷ 8 取余数，对应先天八卦数（无余数则取8=坤）",
        "动爻": "(两数之和) ÷ 6 取余数，确定动爻位置（无余数则取第6爻）"
      },
      "先天八卦数": {
        "1": "乾", "2": "兑", "3": "离", "4": "震",
        "5": "巽", "6": "坎", "7": "艮", "8": "坤"
      }
    },
    "时间起卦": {
      "描述": "以问卦时的年月日时起卦",
      "规则": {
        "上卦": "(年数+月数+日数) ÷ 8 取余",
        "下卦": "(年数+月数+日数+时数) ÷ 8 取余",
        "动爻": "(年数+月数+日数+时数) ÷ 6 取余"
      }
    },
    "物象起卦": {
      "描述": "以所见之物起卦",
      "规则": "见到的物体可取象起卦，如见一物可取上卦，见另一物可取下卦"
    }
  },
  "断卦规则": {
    "体用分辨": {
      "原则": "动爻所在卦为用卦，不动之卦为体卦",
      "说明": "体卦代表求占者自己，用卦代表所问之事或外界环境"
    },
    "五行生克判断": {
      "用生体": "大吉 — 外界有利于自己，有人帮助，事情顺利",
      "体生用": "小凶（泄气）— 自己消耗精力，付出多收获少",
      "用克体": "大凶 — 外界克制自己，障碍多，事情难成",
      "体克用": "小吉 — 自己可以掌控局面，可以得到但需要努力",
      "比和": "平吉 — 势均力敌，事情平稳"
    },
    "卦象综合分析": {
      "卦象取象": "根据卦的象征意义（乾为天/健，坤为地/顺等）分析",
      "爻辞参考": "参考动爻对应的爻辞",
      "互卦": "取二三四爻为下卦，三四五爻为上卦，组成互卦，代表事情的中间过程",
      "变卦": "动爻变后（阴阳互变）得到的卦，代表事情的最终结果"
    }
  },
